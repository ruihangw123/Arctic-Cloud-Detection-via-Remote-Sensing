\newlabel{findings}{{3}{6}{Findings}{section.3}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.1}First finding: Injury severity dose-response is modulated by age and AMS}{6}{subsection.3.1}\protected@file@percent }
\newlabel{first-finding}{{3.1}{6}{First finding: Injury severity dose-response is modulated by age and AMS}{subsection.3.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Positive CT rate by injury mechanism severity. The overall gradient (2.4\% $\to $ 4.3\% $\to $ 9.4\%) is modulated by age and AMS (see Figures~\ref {fig:age_strat} and~\ref {fig:interaction_ams}).}}{6}{figure.7}\protected@file@percent }
\newlabel{fig:injury}{{7}{6}{Positive CT rate by injury mechanism severity. The overall gradient (2.4\% $\to $ 4.3\% $\to $ 9.4\%) is modulated by age and AMS (see Figures~\ref {fig:age_strat} and~\ref {fig:interaction_ams})}{figure.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Interaction between AMS and injury mechanism severity. The PosCT rate for AMS + high-impact (14.8\%) is super-additive relative to either factor alone, suggesting that the combination carries disproportionate risk.}}{7}{figure.8}\protected@file@percent }
\newlabel{fig:interaction_ams}{{8}{7}{Interaction between AMS and injury mechanism severity. The PosCT rate for AMS + high-impact (14.8\%) is super-additive relative to either factor alone, suggesting that the combination carries disproportionate risk}{figure.8}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.2}Second finding: Risk factor accumulation reveals a steep compound-risk gradient}{7}{subsection.3.2}\protected@file@percent }
\newlabel{second-finding}{{3.2}{7}{Second finding: Risk factor accumulation reveals a steep compound-risk gradient}{subsection.3.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Compound risk: PosCT rate by number of concurrent PECARN risk factors. The 13.5-fold gradient from 0 to 4+ factors is non-linear, suggesting synergistic interactions among risk factors.}}{8}{figure.9}\protected@file@percent }
\newlabel{fig:compound}{{9}{8}{Compound risk: PosCT rate by number of concurrent PECARN risk factors. The 13.5-fold gradient from 0 to 4+ factors is non-linear, suggesting synergistic interactions among risk factors}{figure.9}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.3}Third finding: Data-driven models recover the same predictors as the clinical rule}{8}{subsection.3.3}\protected@file@percent }
\newlabel{third-finding}{{3.3}{8}{Third finding: Data-driven models recover the same predictors as the clinical rule}{subsection.3.3}{}}
