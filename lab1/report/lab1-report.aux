\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Age-stratified predictor effects. Children $<$2 years have higher PosCT rates across all predictor levels. The age gap is largest for moderate injury severity and AMS, supporting the PECARN rule's age-stratified design.}}{4}{figure.3}\protected@file@percent }
\newlabel{fig:age_strat}{{3}{4}{Age-stratified predictor effects. Children $<$2 years have higher PosCT rates across all predictor levels. The age gap is largest for moderate injury severity and AMS, supporting the PECARN rule's age-stratified design}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces CT scan utilization rate by number of PECARN risk factors in the full GCS 14--15 cohort ($n=42{,}430$). Clinicians' ordering decisions already reflect compound risk, rising from 15.5\% (0 factors) to 95.9\% (4+ factors).}}{5}{figure.4}\protected@file@percent }
\newlabel{fig:ct_util}{{4}{5}{CT scan utilization rate by number of PECARN risk factors in the full GCS 14--15 cohort ($n=42{,}430$). Clinicians' ordering decisions already reflect compound risk, rising from 15.5\% (0 factors) to 95.9\% (4+ factors)}{figure.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Selection bias: patients who received CT have higher rates of risk factors (AMS, vomiting, LOC, high-impact injury) and are younger on average, compared to those who were not imaged.}}{5}{figure.5}\protected@file@percent }
\newlabel{fig:selection_bias}{{5}{5}{Selection bias: patients who received CT have higher rates of risk factors (AMS, vomiting, LOC, high-impact injury) and are younger on average, compared to those who were not imaged}{figure.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces GCS 14 vs 15 comparison. Left: PosCT rate (13.7\% vs 4.5\%). Right: prevalence of PECARN risk factors. GCS 14 patients have a qualitatively different risk profile.}}{6}{figure.6}\protected@file@percent }
\newlabel{fig:gcs14v15}{{6}{6}{GCS 14 vs 15 comparison. Left: PosCT rate (13.7\% vs 4.5\%). Right: prevalence of PECARN risk factors. GCS 14 patients have a qualitatively different risk profile}{figure.6}{}}
