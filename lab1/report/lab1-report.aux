\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces Model alignment: logistic regression coefficient vs random forest importance. Predictors in the upper-right (e.g., injury mechanism severity, altered mental status) are emphasized by both models.}}{12}{figure.13}\protected@file@percent }
\newlabel{fig:lr_coef}{{13}{12}{Model alignment: logistic regression coefficient vs random forest importance. Predictors in the upper-right (e.g., injury mechanism severity, altered mental status) are emphasized by both models}{figure.13}{}}
